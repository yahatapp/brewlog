# -----------------------------------------------------------------------------
# Coffee Profile LIFF App - Environment Variables Example
# -----------------------------------------------------------------------------

# [LINE Developers]
# LINE Developers Console (https://developers.line.biz/) で取得した LIFF ID
# フロントエンドの初期化（@line/liff）に使用されます。
VITE_LIFF_ID=your_liff_id_here

# [Supabase - Frontend]
# Supabase プロジェクトの URL と Anon Key
# フロントエンドから Supabase への直接アクセス（Storage等）に使用されます。
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# [Supabase - Backend/Database]
# Drizzle ORM やバックエンド（Hono）からデータベースに接続するための文字列
# ローカル開発やマイグレーションの実行時に使用されます。
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# [Cloudflare / Hono]
# 開発環境のデバッグモード（必要に応じて）
NODE_ENV=development
