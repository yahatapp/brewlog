{
  "name": "brewlog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "guard:agent": "pnpm run check:fix && pnpm run guard:changes",
    "guard:changes": "./scripts/guard-changes.sh",
    "guard:gitleaks-canary": "./scripts/check-gitleaks-canary.sh",
    "guard:secrets": "gitleaks dir --no-banner --redact .",
    "test": "vp test",
    "deploy": "pnpm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@line/liff": "^2.23.2",
    "@radix-ui/react-slot": "^1.1.0",
    "base-ui": "latest",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.21",
    "jose": "^6.2.3",
    "lucide-react": "^1.0.0",
    "postgres": "^3.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.0.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/workers-types": "^4.20240401.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.31.10",
    "lefthook": "2.1.10",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "4.1.10",
    "wrangler": "^4.92.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd",
      "esbuild",
      "lefthook",
      "sharp"
    ],
